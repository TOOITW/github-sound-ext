{
  "manifest_version": 3,
  "name": "GitHub Success Sound",
  "version": "0.1",
  "description": "在 GitHub Actions 成功 / PR 合併 / push 成功時播放音效。",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Sound",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "offscreen_pages": ["offscreen.html"]
}
